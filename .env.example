# ── Chain ──────────────────────────────────────────

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=0x7c5BF43B851c1dff1a4feE8dB225b87f2C223639  # cUSDCMock (ERC-7984)

# ── Indexer ────────────────────────────────────────

# Starting block for indexing. Must be set — the deploy block is known.
# Find it with:   cast tx <CONTRACT_DEPLOY_TX> --field blockNumber
START_BLOCK=10145056

# ── Decryption ─────────────────────────────────────

# EOA for Zama SDK decryption. Worker starts only when this is set.
INDEXER_PRIVATE_KEY=

# ── E2E Test Keys ──────────────────────────────────

# Wallet used by scripts/e2e-setup.ts. Generate with:
#   pnpm tsx scripts/e2e-setup.ts generate-key
TEST_WALLET_KEY=

# ── Server ─────────────────────────────────────────

PORT=3000
